@page
@model Khramtsevich_lab.UI.Areas.Admin.Pages.IndexModel

@{
    ViewData["Title"] = "Admin / Dishes";
}

<h1 class="mb-3">Администрирование блюд</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> Добавить
    </a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Название</th>
            <th>Описание</th>
            <th>Цена</th>
            <th>Вес</th>
            <th>Изображение</th>
            <th>Категория</th>
            <th class="text-end">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Dishes)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.Price</td>
                <td>@item.Weight</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.Image))
                    {
                        <img src="@item.Image" style="height:60px; object-fit:cover;" />
                    }
                </td>
                <td>@item.Category?.Name</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary"
                       asp-page="Edit" asp-route-id="@item.Id" title="Edit">
                        <i class="fa-solid fa-pen"></i>
                    </a>

                    <a class="btn btn-sm btn-outline-secondary ms-1"
                       asp-page="Details" asp-route-id="@item.Id" title="Details">
                        <i class="fa-solid fa-circle-info"></i>
                    </a>

                    <a class="btn btn-sm btn-outline-danger ms-1"
                       asp-page="Delete" asp-route-id="@item.Id" title="Delete">
                        <i class="fa-solid fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<pager admin="true"
       current-page="@Model.CurrentPage"
       total-pages="@Model.TotalPages"></pager>
