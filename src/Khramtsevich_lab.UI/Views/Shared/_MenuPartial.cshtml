@* Меню навигации с подсветкой активного пункта *@
@{
    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLower();
    var area = (ViewContext.RouteData.Values["area"]?.ToString() ?? string.Empty).ToLower();
}

<div class="navbar-nav">
    <a class="nav-item nav-link @(controller == "home" ? "active" : "")"
       asp-controller="Home" asp-action="Index">ЛБ 1</a>

    <a class="nav-item nav-link @(controller == "product" ? "active" : "")"
       asp-controller="Product" asp-action="Index">Каталог</a>

    <a class="nav-item nav-link @(area == "admin" ? "active" : "")"
       asp-area="Admin" asp-page="/Index">Администрирование</a>
</div>
