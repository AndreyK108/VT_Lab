@using Khramtsevich_lab.Domain.Entities
@using Khramtsevich_lab.Domain.Models
@model ProductListModel<Dish>

@{
    ViewData["Title"] = "Меню кафе";

    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();

    var request = ViewContext.HttpContext.Request;

    // ✅ Задание 6: категория теперь часть маршрута (/Catalog/soups)
    var selectedCategory = request.RouteValues["category"]?.ToString();

    var currentPage = Model?.CurrentPage ?? 1;
    var totalPages = Model?.TotalPages ?? 1;
}

<div class="container mt-5">
    <div class="row">
        <!-- Сайдбар с категориями -->
        <div class="col-md-3">
            <h5>Категории</h5>
            <div class="list-group">
                <a href="@Url.Action("Index", "Product", new { pageNo = 1, category = (string?)null })"
                   class="list-group-item list-group-item-action @(selectedCategory == null ? "active" : "")">
                    Все блюда
                </a>
                @foreach (var cat in categories)
                {
                    <a href="@Url.Action("Index", "Product", new { category = cat.NormalizedName, pageNo = 1 })"
                       class="list-group-item list-group-item-action @(selectedCategory == cat.NormalizedName ? "active" : "")">
                        @cat.Name
                    </a>
                }
            </div>
        </div>

        <!-- Список блюд -->
        <div class="col-md-9">
            <h3>
                @(selectedCategory != null
                                ? $"Категория: {categories.FirstOrDefault(c => c.NormalizedName == selectedCategory)?.Name}"
                                : "Все блюда")
            </h3>

            <div class="row">
                @foreach (var dish in (Model?.Items ?? new List<Dish>()))
                {
                    <partial name="_ProductItemPartial" model="dish" />
                }
            </div>

            @if (Model == null || Model.Items == null || !Model.Items.Any())
            {
                <div class="alert alert-info">
                    Блюда в этой категории не найдены.
                </div>
            }
            else
            {
                <pager page-current="@currentPage"
                       page-total="@totalPages"
                       action="Index"
                       controller="Product"
                       category="@selectedCategory">
                </pager>
            }
        </div>
    </div>
</div>
