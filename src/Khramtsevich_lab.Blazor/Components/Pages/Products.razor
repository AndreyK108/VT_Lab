@page "/products"
@rendermode InteractiveServer

@using System.Linq
@using Khramtsevich_lab.Domain.Entities
@using Khramtsevich_lab.Blazor.Services
@using Khramtsevich_lab.Blazor.Components.ProductComponents

<CascadingValue Value="ProductService">
    <DishesList DishSelected="ShowDetails" />
</CascadingValue>

<DishDetails Dish="SelectedDish" />

@code {
    [Inject] public IProductService<Dish> ProductService { get; set; } = default!;

    [Parameter]
    public Dish? SelectedDish { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ProductService.GetProducts();
    }

    void ShowDetails(int id)
    {
        SelectedDish = ProductService.Products!.First(d => d.Id == id);
    }
}
