@using Domain.Entities
@model Dish

@{
    var request = ViewContext.HttpContext.Request;
    var returnUrl = request.Path + request.QueryString.ToUriComponent();

    var imgSrc = string.IsNullOrWhiteSpace(Model.Image)
        ? null
        : Url.Content($"~/{Model.Image}");
}

<div class="col-md-6 col-lg-4 mb-4">
    <div class="card h-100 d-flex flex-column">

        @if (!string.IsNullOrEmpty(imgSrc))
        {
            <img src="@imgSrc" class="card-img-top" alt="@Model.Name"
                 style="height: 200px; object-fit: cover;">
        }
        else
        {
            <div style="height: 200px; background-color: #e9ecef; display: flex;
                            align-items: center; justify-content: center;">
                <span class="text-muted">Нет изображения</span>
            </div>
        }

        <div class="card-body d-flex flex-column">
            <h5 class="card-title">@Model.Name</h5>
            <p class="card-text">@Model.Description</p>

            <div class="d-flex justify-content-between align-items-center mt-auto mb-3">
                <span>
                    @if (Model.Weight.HasValue)
                    {
                        <span>Вес: @Model.Weight г.</span>
                    }
                </span>
                <strong>@Model.Price.ToString("C")</strong>
            </div>

            <a asp-controller="Cart"
               asp-action="Add"
               asp-route-id="@Model.Id"
               asp-route-returnUrl="@returnUrl"
               class="btn btn-primary w-100">
                В корзину
            </a>
        </div>

    </div>
</div>
